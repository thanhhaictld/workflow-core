# Server-side only. The Next.js rewrite sends same-origin /backend/* requests here.
WORKFLOW_API_URL=http://localhost:5000

# Hub operations dashboard: server-side credential only.
WORKFLOW_HUB_URL=http://localhost:5100
WORKFLOW_HUB_TOKEN=
# Optional OpenTelemetry/Prometheus process metrics (not a browser URL)
WORKFLOW_PROMETHEUS_URL=http://localhost:9090
