FROM mcr.microsoft.com/dotnet/sdk:10.0 AS build
WORKDIR /src
COPY . .
RUN dotnet build scaling/WorkflowCore.Scaling.slnx -c Release

FROM build AS tests
ENTRYPOINT ["dotnet", "test", "scaling/tests/WorkflowCore.Scaling.PostgreSQL.Tests/WorkflowCore.Scaling.PostgreSQL.Tests.csproj", "-c", "Release", "--no-build", "--logger", "trx;LogFileName=owner-recovery.trx"]
CMD ["--results-directory", "/results"]

FROM build AS publish-hub
RUN dotnet publish scaling/src/WorkflowCore.Hub.Server/WorkflowCore.Hub.Server.csproj -c Release --no-restore -o /out /p:UseAppHost=false
FROM mcr.microsoft.com/dotnet/aspnet:10.0 AS hub
WORKDIR /app
COPY --from=publish-hub /out ./
USER app
ENTRYPOINT ["dotnet"]

FROM build AS publish-processor
RUN dotnet publish scaling/sample/offboarding/WorkflowCore.Offboarding.Processor/WorkflowCore.Offboarding.Processor.csproj -c Release --no-restore -o /out /p:UseAppHost=false
FROM mcr.microsoft.com/dotnet/aspnet:10.0 AS processor
WORKDIR /app
COPY --from=publish-processor /out ./
USER app
ENTRYPOINT ["dotnet"]
