# Next.js workflow monitor, with its existing .NET monitor API reverse proxy.
FROM node:22-alpine AS build
WORKDIR /app
COPY scaling/monitor/package.json scaling/monitor/pnpm-lock.yaml ./
RUN corepack pnpm install --frozen-lockfile
COPY scaling/monitor/ ./
# Next.js rewrites are resolved at build time: use Compose-internal DNS.
ENV WORKFLOW_API_URL=http://monitor-api:5000
ENV NEXT_TELEMETRY_DISABLED=1
RUN corepack pnpm run build

FROM node:22-alpine
WORKDIR /app
ENV NODE_ENV=production
ENV NEXT_TELEMETRY_DISABLED=1
COPY --from=build /app/.next/standalone ./
COPY --from=build /app/.next/static ./.next/static
USER node
EXPOSE 3000
CMD ["node", "server.js"]
