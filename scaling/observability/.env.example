# Private, loopback-only local observability lab; DO NOT use these values in production.
PG_USER=workflow
PG_PASSWORD=workflow_dev_only
PG_DATABASE=workflow
WFC_HUB_AUTH_TOKEN=local-workflow-hub-telemetry-change-this-2026
WFC_HUB_DB_POOL=12
WORKERS=16
WORKFLOW_WORKERS=8
ACTIVITY_WORKERS=16
GRAFANA_USER=admin
GRAFANA_PASSWORD=local-grafana-change-this
HUB_PORT=5100
GRAFANA_PORT=3001
MONITOR_PORT=3002
MONITOR_API_PORT=5000
# Disable legacy worker polling while stressing the new Hub workload.
MONITOR_EMBEDDED_WORKER=false
PROMETHEUS_PORT=9090
TEMPO_PORT=3200
OTLP_HTTP_PORT=4318
# k6 shared-iterations mode submits exactly this many workflows.
K6_WORKFLOWS=1000
K6_VUS=100
K6_MAX_WAIT_SECONDS=180
# k6 auto-generates a fresh run ID if K6_RUN_ID is blank.
K6_RUN_ID=

# Use tenant-onboarding-timer to stress 1000 durable timer waits.
K6_DEFINITION=tenant-onboarding
K6_VERSION=3
HUB_SCHEDULER_ENABLED=true

# Native-only offboarding benchmark (8 processor replicas).
# No remote activities, per-resource keys, or strict FIFO policies.
OFFBOARD_PROCESSOR_WORKERS=16
K6_OFFBOARD_COUNT=1000
K6_OFFBOARD_VUS=100
K6_OFFBOARD_TIMEOUT_SECONDS=360
# Leave empty to generate an isolated run ID.
K6_OFFBOARD_RUN_ID=
